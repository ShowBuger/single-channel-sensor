{
    "configurations": [
        {
            "name": "STM32",
            "includePath": [
                "${workspaceFolder}/firmware/src",
                "${workspaceFolder}/firmware/src/app",
                "${workspaceFolder}/firmware/src/drivers/bsp",
                "${workspaceFolder}/firmware/src/drivers/sensors",
                "${workspaceFolder}/firmware/libs/CMSIS/Core/Include",
                "${workspaceFolder}/firmware/libs/CMSIS/Device/ST/STM32F1xx/Include",
                "${workspaceFolder}/firmware/libs/STM32F1xx_HAL_Driver/Inc"
            ],
            "defines": [
                "USE_HAL_DRIVER",
                "STM32F103xB",
                "DEBUG"
            ],
            "compilerPath": "arm-none-eabi-gcc",
            "cStandard": "c11",
            "cppStandard": "c++17",
            "intelliSenseMode": "gcc-arm",
            "compileCommands": "${workspaceFolder}/firmware/build/compile_commands.json",
            "configurationProvider": "ms-vscode.cmake-tools"
        }
    ],
    "version": 4
}
