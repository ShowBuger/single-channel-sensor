{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "CMake: Build",
            "type": "shell",
            "command": "${workspaceFolder}/firmware/tools/build.ps1",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$gcc"]
        },
        {
            "label": "CMake: Build Release",
            "type": "shell",
            "command": "${workspaceFolder}/firmware/tools/build.ps1",
            "args": ["-Release"],
            "group": "build",
            "problemMatcher": ["$gcc"]
        },
        {
            "label": "CMake: Rebuild",
            "type": "shell",
            "command": "${workspaceFolder}/firmware/tools/build.ps1",
            "args": ["-Clean"],
            "group": "build",
            "problemMatcher": ["$gcc"]
        },
        {
            "label": "Flash (DAPLink)",
            "type": "shell",
            "command": "${workspaceFolder}/firmware/tools/flash.ps1",
            "args": ["-Method", "daplink"],
            "dependsOn": ["CMake: Build"],
            "group": "test",
            "problemMatcher": []
        },
        {
            "label": "Flash (OpenOCD/ST-Link)",
            "type": "shell",
            "command": "${workspaceFolder}/firmware/tools/flash.ps1",
            "args": ["-Method", "openocd"],
            "dependsOn": ["CMake: Build"],
            "group": "test",
            "problemMatcher": []
        },
        {
            "label": "Show Size",
            "type": "shell",
            "command": "$env:Path = [System.Environment]::GetEnvironmentVariable('Path','Machine') + ';' + [System.Environment]::GetEnvironmentVariable('Path','User'); arm-none-eabi-size '${workspaceFolder}/firmware/build/single_channel_sensor.elf'",
            "group": "none",
            "problemMatcher": []
        }
    ]
}
