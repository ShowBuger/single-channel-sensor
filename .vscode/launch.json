{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Cortex Debug (OpenOCD/ST-Link)",
            "type": "cortex-debug",
            "request": "launch",
            "cwd": "${workspaceFolder}",
            "executable": "${workspaceFolder}/firmware/build/single_channel_sensor.elf",
            "servertype": "openocd",
            "configFiles": [
                "interface/stlink.cfg",
                "target/stm32f1x.cfg"
            ],
            "serverpath": "openocd",
            "searchDir": [],
            "runToEntryPoint": "main",
            "showDevDebugOutput": "none",
            "svdFile": "${workspaceFolder}/firmware/docs/STM32F103xx.svd",
            "preLaunchTask": "CMake: Build",
            "postRestartCommands": [
                "break main",
                "continue"
            ]
        },
        {
            "name": "Cortex Debug (J-Link)",
            "type": "cortex-debug",
            "request": "launch",
            "cwd": "${workspaceFolder}",
            "executable": "${workspaceFolder}/firmware/build/single_channel_sensor.elf",
            "servertype": "jlink",
            "device": "STM32F103C8",
            "interface": "swd",
            "serverpath": "JLinkGDBServerCL",
            "runToEntryPoint": "main",
            "showDevDebugOutput": "none",
            "svdFile": "${workspaceFolder}/firmware/docs/STM32F103xx.svd",
            "preLaunchTask": "CMake: Build"
        }
    ]
}
